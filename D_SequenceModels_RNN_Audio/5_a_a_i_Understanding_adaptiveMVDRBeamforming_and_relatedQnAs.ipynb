    "---\n",
    "## 6. Complete MVDR Beamformer Implementation\n",
    "\n",
    "Now let's implement a complete MVDR beamformer and demonstrate its performance."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def mvdr_beamformer(mic_signals, mic_positions, theta_target, fs=SAMPLE_RATE, c=SPEED_OF_SOUND):\n",
    "    \"\"\"\n",
    "    Complete MVDR beamformer implementation.\n",
    "    \n",
    "    Args:\n",
    "        mic_signals: Microphone signals [M mics × T samples]\n",
    "        mic_positions: Microphone positions [M × 2] (x, y coordinates)\n",
    "        theta_target: Target direction (degrees)\n",
    "        fs: Sample rate (Hz)\n",
    "        c: Speed of sound (m/s)\n",
    "    \n",
    "    Returns:\n",
    "        output: Enhanced signal [T samples]\n",
    "        weights: MVDR weights [M × F frequency bins]\n",
    "    \"\"\"\n",
    "    M, T = mic_signals.shape\n",
    "    \n",
    "    # Convert to frequency domain\n",
    "    X_fft = np.fft.rfft(mic_signals, axis=1)  # [M × F]\n",
    "    F = X_fft.shape[1]\n",
    "    freqs = np.fft.rfftfreq(T, 1/fs)\n",
    "    \n",
    "    # Initialize weights\n",
    "    weights = np.zeros((F, M), dtype=complex)\n",
    "    Y_fft = np.zeros(F, dtype=complex)\n",
    "    \n",
    "    # Process each frequency bin\n",
    "    for f_idx, freq in enumerate(freqs):\n",
    "        if freq == 0:\n",
    "            # DC component: use equal weights\n",
    "            weights[f_idx] = np.ones(M) / M\n",
    "        else:\n",
    "            # Compute steering vector\n",
    "            a = compute_steering_vector(mic_positions, theta_target, freq, c)\n",
    "            \n",
    "            # Estimate covariance matrix\n",
    "            X_f = X_fft[:, f_idx:f_idx+1]  # [M × 1]\n",
    "            R = X_f @ X_f.conj().T  # [M × M]\n",
    "            \n",
    "            # Compute MVDR weights\n",
    "            weights[f_idx] = compute_mvdr_weights(R, a)\n",
    "        \n",
    "        # Apply beamformer\n",
    "        Y_fft[f_idx] = weights[f_idx].conj() @ X_fft[:, f_idx]\n",
    "    \n",
    "    # Convert back to time domain\n",
    "    output = np.fft.irfft(Y_fft, n=T)\n",
    "    \n",
    "    return output, weights\n",
    "\n",
    "print(\"✓ Complete MVDR beamformer implemented!\")"
   ]
  },
