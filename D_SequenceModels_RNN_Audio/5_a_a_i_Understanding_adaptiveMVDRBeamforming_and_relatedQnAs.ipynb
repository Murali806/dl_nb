    "    # Covariance matrix (example)\n",
    "    R = np.array([[1.0, 0.3],\n",
    "                  [0.3, 1.0]])\n",
    "    \n",
    "    # Steering vector (example: 0° direction)\n",
    "    a = np.array([1.0, 1.0])\n",
    "    \n",
    "    # Create grid of weights\n",
    "    w1_range = np.linspace(-2, 2, 200)\n",
    "    w2_range = np.linspace(-2, 2, 200)\n",
    "    W1, W2 = np.meshgrid(w1_range, w2_range)\n",
    "    \n",
    "    # Compute cost function for each weight combination\n",
    "    Cost = np.zeros_like(W1)\n",
    "    for i in range(len(w1_range)):\n",
    "        for j in range(len(w2_range)):\n",
    "            w = np.array([W1[j, i], W2[j, i]])\n",
    "            Cost[j, i] = w.T @ R @ w  # Output power\n",
    "    \n",
    "    # Constraint line: w^T a = 1\n",
    "    # w1 * a1 + w2 * a2 = 1\n",
    "    # w2 = (1 - w1 * a1) / a2\n",
    "    w1_constraint = np.linspace(-2, 2, 100)\n",
    "    w2_constraint = (1 - w1_constraint * a[0]) / a[1]\n",
    "    \n",
    "    # Optimal MVDR solution\n",
    "    R_inv = np.linalg.inv(R)\n",
    "    w_mvdr = R_inv @ a / (a.T @ R_inv @ a)\n",
