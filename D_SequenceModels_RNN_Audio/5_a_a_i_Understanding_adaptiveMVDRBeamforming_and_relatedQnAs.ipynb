   "source": [
    "def compute_mvdr_weights(R, a, diagonal_loading=1e-6):\n",
    "    \"\"\"\n",
    "    Compute MVDR beamformer weights.\n",
    "    \n",
    "    Args:\n",
    "        R: Covariance matrix [M × M]\n",
    "        a: Steering vector [M × 1]\n",
    "        diagonal_loading: Regularization parameter\n",
    "    \n",
    "    Returns:\n",
    "        w: MVDR weights [M × 1]\n",
    "    \"\"\"\n",
    "    M = len(a)\n",
    "    \n",
    "    # Add diagonal loading for numerical stability\n",
    "    R_reg = R + diagonal_loading * np.eye(M)\n",
    "    \n",
    "    # Compute inverse\n",
    "    R_inv = np.linalg.inv(R_reg)\n",
    "    \n",
    "    # MVDR formula\n",
    "    numerator = R_inv @ a\n",
    "    denominator = a.conj().T @ R_inv @ a\n",
    "    w = numerator / denominator\n",
    "    \n",
    "    return w\n",
    "\n",
    "def visualize_weight_calculation_steps(R, a):\n",
    "    \"\"\"\n",
    "    Visualize each step of MVDR weight calculation.\n",
    "    \"\"\"\n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(\"MVDR WEIGHT CALCULATION: STEP-BY-STEP\")\n",
    "    print(\"=\"*70)\n",
    "    \n",
    "    # Step 1: Show inputs\n",
    "    print(\"\\nStep 1: Inputs\")\n",
    "    print(\"-\" * 70)\n",
    "    print(\"Covariance matrix R:\")\n",
    "    print(R)\n",
    "    print(\"\\nSteering vector a:\")\n",
    "    print(a)\n",
    "    \n",
    "    # Step 2: Compute R^-1\n",
    "    R_inv = np.linalg.inv(R)\n",
    "    print(\"\\nStep 2: Compute R⁻¹ (inverse of covariance matrix)\")\n",
    "    print(\"-\" * 70)\n",
    "    print(\"R⁻¹ =\")\n",
    "    print(R_inv)\n",
    "    \n",
    "    # Step 3: Compute R^-1 * a\n",
    "    R_inv_a = R_inv @ a\n",
    "    print(\"\\nStep 3: Compute R⁻¹·a (whitened steering vector)\")\n",
    "    print(\"-\" * 70)\n",
    "    print(\"R⁻¹·a =\")\n",
    "    print(R_inv_a)\n",
    "    print(\"\\nPhysical meaning: This 'whitens' the steering vector\")\n",
    "    print(\"  → Decorrelates noise components\")\n",
    "    \n",
    "    # Step 4: Compute denominator\n",
    "    denominator = a.conj().T @ R_inv @ a\n",
    "    print(\"\\nStep 4: Compute aᴴ·R⁻¹·a (normalization factor)\")\n",
    "    print(\"-\" * 70)\n",
    "    print(f\"aᴴ·R⁻¹·a = {denominator:.6f}\")\n",
    "    print(\"\\nPhysical meaning: Ensures constraint wᴴ·a = 1 is satisfied\")\n",
    "    \n",
    "    # Step 5: Final weights\n",
    "    w = R_inv_a / denominator\n",
    "    print(\"\\nStep 5: Compute final weights w = (R⁻¹·a) / (aᴴ·R⁻¹·a)\")\n",
    "    print(\"-\" * 70)\n",
    "    print(\"MVDR weights w =\")\n",
    "    print(w)\n",
    "    \n",
    "    # Verify constraint\n",
    "    constraint_check = a.conj().T @ w\n",
    "    print(\"\\nStep 6: Verify constraint wᴴ·a = 1\")\n",
    "    print(\"-\" * 70)\n",
    "    print(f\"wᴴ·a = {constraint_check:.6f}\")\n",
    "    print(f\"✓ Constraint satisfied!\" if np.abs(constraint_check - 1) < 1e-6 else \"✗ Constraint NOT satisfied!\")\n",
    "    \n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    \n",
    "    # Visualize weights\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "    \n",
    "    # Magnitude\n",
    "    ax = axes[0]\n",
    "    mics = [f'Mic {i+1}' for i in range(len(w))]\n",
    "    magnitudes = np.abs(w)\n",
    "    \n",
    "    bars = ax.bar(mics, magnitudes, color=['blue', 'red'], alpha=0.7, edgecolor='black', linewidth=2)\n",
    "    for bar, mag in zip(bars, magnitudes):\n",
    "        height = bar.get_height()\n",
    "        ax.text(bar.get_x() + bar.get_width()/2., height,\n",
    "                f'{mag:.3f}', ha='center', va='bottom', fontsize=11, weight='bold')\n",
    "    \n",
    "    ax.set_ylabel('Magnitude', fontsize=11)\n",
    "    ax.set_title('MVDR Weights: Magnitude', fontsize=12, weight='bold')\n",
    "    ax.grid(True, alpha=0.3, axis='y')\n",
    "    \n",
    "    # Phase\n",
    "    ax = axes[1]\n",
    "    phases = np.angle(w, deg=True)\n",
    "    \n",
    "    bars = ax.bar(mics, phases, color=['blue', 'red'], alpha=0.7, edgecolor='black', linewidth=2)\n",
    "    for bar, phase in zip(bars, phases):\n",
    "        height = bar.get_height()\n",
    "        ax.text(bar.get_x() + bar.get_width()/2., height,\n",
    "                f'{phase:.1f}°', ha='center', va='bottom' if height >= 0 else 'top',\n",
    "                fontsize=11, weight='bold')\n",
    "    \n",
    "    ax.set_ylabel('Phase (degrees)', fontsize=11)\n",
    "    ax.set_title('MVDR Weights: Phase', fontsize=12, weight='bold')\n",
    "    ax.grid(True, alpha=0.3, axis='y')\n",
    "    ax.axhline(y=0, color='gray', linestyle='--', linewidth=1)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return w\n",
    "\n",
    "# Example\n",
    "R_example = np.array([[1.0, 0.3+0.2j],\n",
    "                      [0.3-0.2j, 1.0]])\n",
    "a_example = np.array([1.0+0j, 0.8-0.6j])\n",
    "\n",
    "w_mvdr = visualize_weight_calculation_steps(R_example, a_example)"
   ]
