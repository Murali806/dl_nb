    "    noise2_corr = noise_source * phase_shift\n",
    "    X_corr = np.array([noise1_corr, noise2_corr])\n",
    "    R_corr = estimate_covariance_matrix(X_corr)\n",
    "    \n",
    "    print(\"\\n\" + \"=\"*70)\n",
