    "        speech_source * phase_shift_speech + diffuse2\n",
    "    ])\n",
    "    R_mixed = estimate_covariance_matrix(X_mixed)\n",
    "    \n",
    "    print(\"\\n\" + \"=\"*70)\n",
    "    print(\"Scenario 3: Mixed (Speech from 0° + Diffuse Noise)\")\n",
    "    visualize_covariance_matrix(R_mixed, \"Covariance Matrix: Speech + Diffuse Noise\")\n",
    "    print(\"\\nObservations:\")\n",
    "    print(\"  • Moderate correlation (speech component)\")\n",
    "    print(\"  • Higher diagonal (total power)\")\n",
    "    print(\"  • MVDR needs noise-only R for best performance\")\n",
    "\n",
    "demonstrate_covariance_matrices()"
