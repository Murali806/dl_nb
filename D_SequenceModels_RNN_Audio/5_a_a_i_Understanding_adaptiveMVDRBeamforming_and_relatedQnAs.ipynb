    "def demonstrate_mvdr_performance():\n",
    "    \"\"\"\n",
    "    Compare MVDR with delay-and-sum beamforming.\n",
    "    \"\"\"\n",
    "    # Parameters\n",
    "    d = 0.05  # 5cm spacing\n",
    "    mic_positions = np.array([[0, 0], [d, 0]])\n",
    "    \n",
    "    duration = 0.5  # seconds\n",
    "    T = int(duration * SAMPLE_RATE)\n",
    "    t = np.linspace(0, duration, T)\n",
    "    \n",
    "    # Speech from 0° (target)\n",
    "    speech_freq = 300\n",
    "    speech = np.sin(2 * np.pi * speech_freq * t)\n",
    "    \n",
    "    # Interferer from 60°\n",
    "    interferer_freq = 800\n",
    "    interferer_angle = 60\n",
    "    interferer = 1.5 * np.sin(2 * np.pi * interferer_freq * t)\n",
    "    \n",
    "    # Diffuse noise\n",
    "    np.random.seed(42)\n",
    "    noise1 = 0.3 * np.random.randn(T)\n",
    "    noise2 = 0.3 * np.random.randn(T)\n",
    "    \n",
    "    # Create delayed versions\n",
    "    def create_delayed_signal(signal, angle):\n",
    "        tau = d * np.sin(np.radians(angle)) / SPEED_OF_SOUND\n",
    "        tau_samples = int(tau * SAMPLE_RATE)\n",
    "        delayed = np.zeros_like(signal)\n",
    "        if tau_samples > 0:\n",
    "            delayed[tau_samples:] = signal[:-tau_samples]\n",
    "        else:\n",
    "            delayed = signal.copy()\n",
    "        return delayed\n",
    "    \n",
    "    speech_delayed = create_delayed_signal(speech, 0)\n",
    "    interferer_delayed = create_delayed_signal(interferer, interferer_angle)\n",
    "    \n",
    "    # Microphone signals\n",
    "    mic1 = speech + interferer + noise1\n",
    "    mic2 = speech_delayed + interferer_delayed + noise2\n",
    "    mic_signals = np.array([mic1, mic2])\n",
    "    \n",
    "    # Apply MVDR\n",
    "    output_mvdr, weights_mvdr = mvdr_beamformer(mic_signals, mic_positions, theta_target=0)\n",
    "    \n",
    "    # Apply delay-and-sum for comparison\n",
    "    tau_speech = d * np.sin(np.radians(0)) / SPEED_OF_SOUND\n",
    "    tau_samples = int(tau_speech * SAMPLE_RATE)\n",
    "    mic2_aligned = np.zeros_like(mic2)\n",
    "    if
