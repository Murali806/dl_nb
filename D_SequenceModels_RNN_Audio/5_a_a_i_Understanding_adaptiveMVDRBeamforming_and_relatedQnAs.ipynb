   "source": [
    "def demonstrate_covariance_matrices():\n",
    "    \"\"\"\n",
    "    Show covariance matrices for different noise scenarios.\n",
    "    \"\"\"\n",
    "    T = 1000  # Number of time frames\n",
    "    \n",
    "    # Scenario 1: Uncorrelated noise (diffuse)\n",
    "    np.random.seed(42)\n",
    "    noise1 = np.random.randn(T) + 1j * np.random.randn(T)\n",
    "    noise2 = np.random.randn(T) + 1j * np.random.randn(T)\n",
    "    X_uncorr = np.array([noise1, noise2])\n",
    "    R_uncorr = estimate_covariance_matrix(X_uncorr)\n",
    "    \n",
    "    print(\"Scenario 1: Uncorrelated Noise (Diffuse)\")\n",
    "    visualize_covariance_matrix(R_uncorr, \"Covariance Matrix: Uncorrelated Noise\")\n",
    "    print(\"\\nObservations:\")\n",
    "    print(\"  • Diagonal dominant (R₁₁ ≈ R₂₂ ≈ 1)\")\n",
    "    print(\"  • Off-diagonal small (R₁₂ ≈ 0) → uncorrelated\")\n",
    "    print(\"  • This is ideal for delay-and-sum beamforming\")\n",
    "    \n",
    "    # Scenario 2: Correlated noise (directional interferer)\n",
    "    interferer_angle = 60  # degrees\n",
