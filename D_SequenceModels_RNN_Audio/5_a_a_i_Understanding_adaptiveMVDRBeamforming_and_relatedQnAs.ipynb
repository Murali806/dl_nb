    "\n",
    "# Constants\n",
    "SPEED_OF_SOUND = 343  # m/s at 20°C\n",
    "SAMPLE_RATE = 16000   # Hz\n",
    "\n",
    "print(\"✓ Libraries imported successfully!\")\n",
    "print(f\"✓ Speed of sound: {SPEED_OF_SOUND} m/s\")\n",
