    "    print(\"Constraint: Must preserve signal from target direction (red line)\")\n",
    "    print(\"\\nSolution: Point on constraint line with minimum cost\")\n",
    "    print(f\"  • Optimal weights: w = [{w_mvdr[0]:.3f}, {w_mvdr[1]:.3f}]\")\n",
